---
layout: layout.njk
---
<article class="post">
  <p class="post-back"><a href="/">← 목록으로</a></p>
  <p class="post-meta">{{ date | koreanDate }}{% if tag %} · {{ tag }}{% endif %}</p>
  <h1 class="post-title-full">{{ title }}</h1>
  <div class="post-body">
    {{ content | safe }}
  </div>
</article>
